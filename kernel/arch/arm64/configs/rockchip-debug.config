# Quectel PI debug/tracing kernel config fragment
# Enables perf, ftrace, kprobes/uprobes and full debug symbols.
# Referenced via RK_KERNEL_CFG_FRAGMENTS in the Quectel PI defconfigs.
#
# NOTE: these are incremental fragments merged on top of the base
# rockchip_linux_defconfig by merge_config.sh.

# --- perf ---
CONFIG_PERF_EVENTS=y

# --- ftrace ---
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_FTRACE_SYSCALLS=y
CONFIG_STACK_TRACER=y

# --- kprobes / uprobes ---
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y

# --- debug info & symbols (gdb, perf annotate) ---
CONFIG_DEBUG_INFO=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y

# --- debugfs / tracefs ---
CONFIG_DEBUG_FS=y
CONFIG_DEBUG_FS_ALLOW_ALL=y
