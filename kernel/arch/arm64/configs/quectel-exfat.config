# Quectel exFAT support — M2 default kernel
# Tests on Quectel Pi M2 (RK3576, kernel 6.1.118-rt36) showed the stock
# rockchip_linux_defconfig leaves CONFIG_EXFAT_FS off, so exFAT-formatted
# SD cards / USB drives are not recognized ("unsupported format" in GNOME
# Files), while FAT32 (vfat) and NTFS (ntfs-3g fuse) work fine.
#
# NOTE: RK3576 kernel is statically built (empty /lib/modules), so the
# option MUST be =y (built-in).  `=m` modules never load on this platform.
#
# NLS dependencies (CONFIG_NLS_CODEPAGE_936 / CONFIG_NLS_UTF8) are already
# enabled in the base rockchip_linux_defconfig.
CONFIG_EXFAT_FS=y
CONFIG_EXFAT_DEFAULT_IOCHARSET="cp936"
