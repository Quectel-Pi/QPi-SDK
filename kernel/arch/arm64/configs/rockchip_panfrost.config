# Panfrost GPU config fragment — Debian 13 (trixie) GNOME-on-Wayland.
#
# Switches the RK3576 Mali-G52 (Bifrost) from the ARM proprietary "mali" kernel
# driver to the mainline open-source Panfrost DRM driver. Panfrost exposes a
# standard DRM render node, so Mutter/GNOME 48 can use its normal GBM/KMS path
# (mesa) — the libmali blob only offers a private /dev/mali0 GBM that Mutter
# can't use, which is why GNOME-on-Wayland black-screens.
#
# The RK3576 GPU device-tree node has interrupt-names = "GPU","MMU","JOB"
# (uppercase). Panfrost needs lowercase ("gpu"/"mmu"/"job") to match via
# platform_get_irq_byname(). The mk-kernel.sh apply_panfrost_overlay() function
# applies rk3576-panfrost-gpu.dtbo to fix this at build time.
#
# This fragment is applied automatically when RK_KERNEL_USE_PANFROST=y
# (set via Kconfig when RK_DEBIAN_TRIXIE is selected).

# Disable the proprietary ARM Mali Bifrost kernel driver
# CONFIG_MALI_BIFROST is not set
# CONFIG_MALI_MIDGARD is not set

# Enable mainline Panfrost DRM driver + GPU DevFreq
CONFIG_DRM_PANFROST=y
CONFIG_DRM_GEM_SHMEM_HELPER=y
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
