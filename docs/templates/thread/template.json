{
  "id": "thread",
  "name": "多线程（pthread）",
  "icon": "🧵",
  "tag": "系统",
  "category": "系统",
  "description": "pthread 多线程示例：两个工作线程并发运行，主线程等待回收。适合学习线程创建、传参、回收。",
  "expected": "两个线程交替打印多次，最后主线程输出回收结果。",
  "difficulty": 2,
  "peripherals": [
    "无"
  ],
  "files": [
    "main.c",
    "CMakeLists.txt"
  ],
  "variables": {
    "PROJECT_NAME": {
      "label": "项目名称",
      "type": "text",
      "default": "thread_demo",
      "hint": "仅限字母、数字、下划线"
    },
    "THREADS": {
      "label": "线程数量",
      "type": "text",
      "default": "2",
      "hint": "1-8 个线程"
    },
    "LOOPS": {
      "label": "每个线程循环次数",
      "type": "text",
      "default": "5",
      "hint": "打印次数"
    }
  }
}
