{
  "id": "rtc",
  "name": "RTC 实时时钟",
  "icon": "🕐",
  "tag": "RTC",
  "category": "外设",
  "description": "读取/设置 RTC 芯片（PCF8563）时间，并演示系统时间与 RTC 的同步。适合需要掉电保持时间的场景。",
  "expected": "打印当前 RTC 时间，可手动设置新时间后再次读取验证。",
  "difficulty": 1,
  "peripherals": [
    "RTC",
    "PCF8563",
    "I2C"
  ],
  "files": [
    "main.c",
    "CMakeLists.txt"
  ],
  "variables": {
    "PROJECT_NAME": {
      "label": "项目名称",
      "type": "text",
      "default": "rtc_demo",
      "hint": "仅限字母、数字、下划线"
    },
    "RTC_DEV": {
      "label": "RTC 设备节点",
      "type": "text",
      "default": "/dev/rtc0",
      "hint": "板子上 ls /dev/rtc* 查看; hwclock -r 可读当前值"
    },
    "ACTION": {
      "label": "操作",
      "type": "choice",
      "default": "read",
      "choices": [
        {
          "value": "read",
          "label": "读取 RTC 时间"
        },
        {
          "value": "sync",
          "label": "系统时间写入 RTC"
        },
        {
          "value": "both",
          "label": "先读再写再读 (验证)"
        }
      ]
    }
  }
}
