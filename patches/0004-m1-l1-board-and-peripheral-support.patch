diff --git a/drivers/power/supply/virtual_charger.c b/drivers/power/supply/virtual_charger.c
new file mode 100755
index 0000000000000000000000000000000000000000..82f5826fd26a8806d1158ebdc16656c817f4f81c
--- /dev/null
+++ b/drivers/power/supply/virtual_charger.c
@@ -0,0 +1,164 @@
+
+#include <linux/of.h>
+#include <linux/types.h>
+#include <linux/module.h>
+#include <linux/power_supply.h>
+#include <linux/platform_device.h>
+
+static struct power_supply *usb_psy;
+static struct power_supply *bat_psy;
+
+static int virtual_usb_get_prop(struct power_supply *psy,
+					     enum power_supply_property psp,
+					     union power_supply_propval *val)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_ONLINE:
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 0;
+		break;
+	case POWER_SUPPLY_PROP_TYPE:
+		val->intval = POWER_SUPPLY_TYPE_USB;
+		break;
+	default:
+		pr_err("get prop %d is not supported in usb\n", psp);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static char *virtual_usb_supplied_to[] = { "battery" };
+
+static enum power_supply_property virtual_usb_props[] = {
+	POWER_SUPPLY_PROP_TYPE,
+	POWER_SUPPLY_PROP_ONLINE,
+	POWER_SUPPLY_PROP_PRESENT,
+};
+
+static const struct power_supply_desc virtual_usb_psy_desc = {
+	.name = "usb",
+	.type = POWER_SUPPLY_TYPE_USB,
+	.properties = virtual_usb_props,
+	.num_properties = ARRAY_SIZE(virtual_usb_props),
+	.get_property = virtual_usb_get_prop,
+};
+
+static int virtual_battery_get_property(struct power_supply *psy,
+					enum power_supply_property psp,
+					union power_supply_propval *val)
+{
+	switch (psp) {
+	case POWER_SUPPLY_PROP_STATUS:
+		val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		break;
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		break;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		val->intval = 50;
+		break;
+    case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+        val->intval = 4000000;
+        break;
+	case POWER_SUPPLY_PROP_TEMP:
+		val->intval = 250;
+		break;
+	default:
+		pr_err("get prop %d is not supported in battery\n", psp);
+		return -EINVAL;
+	}
+
+	return 0;
+}
+
+static int virtual_battery_set_property(
+			struct power_supply *psy,
+			enum power_supply_property psp,
+			const union power_supply_propval *val)
+{
+	return 0;
+}
+
+static enum power_supply_property virtual_battery_props[] = {
+	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	POWER_SUPPLY_PROP_CAPACITY,
+	POWER_SUPPLY_PROP_VOLTAGE_NOW,
+	POWER_SUPPLY_PROP_TEMP,
+};
+
+static const struct power_supply_desc virtual_bat_psy_desc = {
+	.name = "battery",
+	.type = POWER_SUPPLY_TYPE_BATTERY,
+	.properties = virtual_battery_props,
+	.num_properties = ARRAY_SIZE(virtual_battery_props),
+	.get_property = virtual_battery_get_property,
+	.set_property = virtual_battery_set_property,
+};
+
+static int virtual_probe(struct platform_device *pdev)
+{
+	struct power_supply_config usb_cfg;
+	struct power_supply_config bat_cfg = {
+		.of_node = pdev->dev.of_node,
+	};
+
+	usb_cfg.of_node = pdev->dev.of_node;
+	usb_cfg.supplied_to = virtual_usb_supplied_to;
+	usb_cfg.num_supplicants = ARRAY_SIZE(virtual_usb_supplied_to);
+	usb_psy = devm_power_supply_register(&pdev->dev,
+						  &virtual_usb_psy_desc,
+						  &usb_cfg);
+	if (IS_ERR_OR_NULL(usb_psy)) {
+		pr_err("register usb power supply failed\n");
+		return PTR_ERR(usb_psy);
+	}
+
+	bat_psy = devm_power_supply_register(&pdev->dev, &virtual_bat_psy_desc, &bat_cfg);
+	if (IS_ERR_OR_NULL(bat_psy)) {
+		pr_err("register battery psy failed\n");
+		return PTR_ERR(bat_psy);
+	}
+
+	power_supply_changed(usb_psy);
+	power_supply_changed(bat_psy);
+
+	return 0;
+}
+
+static int virtual_remove(struct platform_device *pdev)
+{
+	power_supply_unregister(usb_psy);
+	power_supply_unregister(bat_psy);
+
+	return 0;
+}
+
+static const struct of_device_id virtual_of_match[] = {
+	{ .compatible = "virtual_battery", },
+	{ },
+};
+
+static struct platform_driver virtual_driver = {
+	.driver = {
+		.name = "virtual-charge",
+		.of_match_table = virtual_of_match,
+	},
+	.probe = virtual_probe,
+	.remove = virtual_remove,
+};
+
+static int virtual_init(void)
+{
+	return platform_driver_register(&virtual_driver);
+}
+
+static void virtual_exit(void)
+{
+	platform_driver_unregister(&virtual_driver);
+}
+
+late_initcall(virtual_init);
+module_exit(virtual_exit);
+MODULE_LICENSE("GPL");
