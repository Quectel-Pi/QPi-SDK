 		role = USB_ROLE_DEVICE;
@@ -4968,6 +4970,32 @@ static enum usb_role dwc3_msm_get_role(struct dwc3_msm *mdwc)
 	else
 		role = USB_ROLE_NONE;
 
+	/*
+	 * On cold boot the cached vbus_active/id_state start as false/FLOAT
+	 * and are only updated by extcon notifiers. If the notifier has not
+	 * fired yet (or the initial sync in probe was skipped), role would
+	 * wrongly read NONE even when a cable is physically present.
+	 * Fall back to querying the extcon device directly in that case so
+	 * that sysfs 'mode' always reflects the real hardware state.
+	 */
