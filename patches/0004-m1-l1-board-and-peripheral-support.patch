index 0000000000000000000000000000000000000000..0598120d3b675b81e5b71f3d40e6e7b2694f937c
--- /dev/null
+++ b/drivers/power/quectel/quec_power_ctrl.c
@@ -0,0 +1,612 @@
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/of.h>
+#include <linux/gpio/consumer.h>
+#include <linux/device.h>
+#include <linux/slab.h>
+#include <linux/delay.h>
+#include <linux/jiffies.h>
+#include <linux/workqueue.h>
+#include <linux/usb.h>
+#include <linux/atomic.h>
+#include <linux/bitops.h>
+#include <linux/extcon.h>
+#include <linux/notifier.h>
+
+/*
+ * GPIO Polarity Reference:
+ * ========================
+ *   usbhub1_en: ACTIVE LOW  - 0=power on, 1=power off
+ *   usbhub2_en: ACTIVE HIGH - 0=off, 1=on
+ *   port_pw_en: ACTIVE HIGH - 0=off, 1=on
+ *   mode_sw:    logic       - 0=host mode, 1=device mode
+ *   eth_en:     ACTIVE HIGH - 0=off, 1=on
+ */
+
+/* Hub check phases */
+enum {
+    CHECK_PHASE_SCAN1 = 0,      /* 1st scan: check 4 hub entities */
+    CHECK_PHASE_SCAN2,          /* 2nd scan: verify recovery */
+    CHECK_PHASE_HUB1_CYCLE,     /* hub1 power cycle if needed */
+    CHECK_PHASE_DONE,           /* check complete */
+};
+
+struct quec_power_ctrl_data {
+    struct gpio_desc *usbhub1_en;   // hub1: 0=on, 1=off (active low)
+    struct gpio_desc *usbhub2_en;   // hub2: 0=off, 1=on (active high)
+    struct gpio_desc *port_pw_en;   // port: 0=off, 1=on
+    struct gpio_desc *mode_sw;      // 0=host, 1=device
+    struct gpio_desc *eth_en;       // eth: 0=off, 1=on
+
+    // extcon monitoring (hw switch/CC path)
+    struct extcon_dev *extcon;      // EXTCON_USB_HOST producer
+    struct notifier_block port_pw_nb;
+
+    // hub async check
+    struct device      *dev;
+    struct workqueue_struct *wq;    // dedicated workqueue
+    struct delayed_work check_work;
+    atomic_t            in_host;     // 1=in host mode
+    atomic_t            check_phase; // current phase
+    struct mutex        mode_lock;   // mode switch mutex
+};
+
+/* Onboard Hub Detection: 2 USB3.0 hubs x (HS+SS) = 4 entities */
+#define CHECK_DELAY_MS    6000   // check delay after host switch (ms)
+#define HUB2_RESTART_MS   500    // hub2 power-off duration (ms)
+
+struct quec_hub_expect {
+    int         bus;
+    const char *devpath;
+    u16         vid;
+    u16         pid;
+    const char *name;
+};
+
+static const struct quec_hub_expect quec_hub_expects[] = {
+    { 1, "1",   0x1a86, 0x80a0, "hub1 HS (1-1)"   },
+    { 2, "1",   0x1a86, 0x80a1, "hub1 SS (2-1)"   },
+    { 1, "1.2", 0x1a86, 0x80a0, "hub2 HS (1-1.2)" },
+    { 2, "1.2", 0x1a86, 0x80a1, "hub2 SS (2-1.2)" },
+};
+#define QUEC_HUB_EXPECT_COUNT \
+    (sizeof(quec_hub_expects) / sizeof(quec_hub_expects[0]))
+
+static ssize_t usbhub1_en_show(struct device *dev,
+                              struct device_attribute *attr, char *buf)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+
+    if (!data->usbhub1_en)
+        return sprintf(buf, "no-gpio\n");
+    return sprintf(buf, "%d\n", gpiod_get_value_cansleep(data->usbhub1_en));
+}
+
+static ssize_t usbhub1_en_store(struct device *dev,
+                               struct device_attribute *attr,
+                               const char *buf, size_t count)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+    int val;
+
+    if (!data->usbhub1_en)
+        return -ENODEV;
+
+    if (kstrtoint(buf, 0, &val))
+        return -EINVAL;
+
+    gpiod_set_value_cansleep(data->usbhub1_en, val ? 1 : 0);
+    return count;
+}
+static DEVICE_ATTR_RW(usbhub1_en);
+
+static ssize_t usbhub2_en_show(struct device *dev,
+                              struct device_attribute *attr, char *buf)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+
+    if (!data->usbhub2_en)
+        return sprintf(buf, "no-gpio\n");
+    return sprintf(buf, "%d\n", gpiod_get_value_cansleep(data->usbhub2_en));
+}
+
+static ssize_t usbhub2_en_store(struct device *dev,
+                               struct device_attribute *attr,
+                               const char *buf, size_t count)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+    int val;
+
+    if (!data->usbhub2_en)
+        return -ENODEV;
+
+    if (kstrtoint(buf, 0, &val))
+        return -EINVAL;
+
+    gpiod_set_value_cansleep(data->usbhub2_en, val ? 1 : 0);
+    return count;
+}
+static DEVICE_ATTR_RW(usbhub2_en);
+
+static ssize_t port_pw_en_show(struct device *dev,
+    struct device_attribute *attr, char *buf)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+
+    if (!data->port_pw_en)
+        return sprintf(buf, "no-gpio\n");
+    return sprintf(buf, "%d\n", gpiod_get_value_cansleep(data->port_pw_en));
+}
+
+static ssize_t port_pw_en_store(struct device *dev,
+     struct device_attribute *attr,
+     const char *buf, size_t count)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+    int val;
+
+    if (!data->port_pw_en)
+        return -ENODEV;
+
+    if (kstrtoint(buf, 0, &val))
+        return -EINVAL;
+
+    gpiod_set_value_cansleep(data->port_pw_en, val ? 1 : 0);
+    return count;
+}
+static DEVICE_ATTR_RW(port_pw_en);
+
+static int quec_port_pw_extcon_notifier(struct notifier_block *nb,
+                                        unsigned long event, void *ptr)
+{
+    struct quec_power_ctrl_data *data =
+        container_of(nb, struct quec_power_ctrl_data, port_pw_nb);
+
+    dev_info(data->dev, "extcon: EXTCON_USB_HOST=%lu -> port_pw_en=%d\n",
+             event, event > 0 ? 1 : 0);
+
+    if (data->port_pw_en)
+        gpiod_set_value_cansleep(data->port_pw_en, event > 0 ? 1 : 0);
+
+    return NOTIFY_OK;
+}
+
+static ssize_t mode_sw_show(struct device *dev,
+                           struct device_attribute *attr, char *buf)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+
+    if (!data->mode_sw)
+        return sprintf(buf, "no-gpio\n");
+    return sprintf(buf, "%d\n", gpiod_get_value_cansleep(data->mode_sw));
+}
+
+/* Hub scan result: found_mask tracks which hubs are present */
+struct quec_hub_scan {
+    unsigned int found_mask;
+};
+
+static int quec_hub_match(struct usb_device *udev, void *data)
+{
+    struct quec_hub_scan *scan = data;
+    int i;
+
+    for (i = 0; i < (int)QUEC_HUB_EXPECT_COUNT; i++) {
+        if (udev->bus->busnum == quec_hub_expects[i].bus &&
+            strcmp(udev->devpath, quec_hub_expects[i].devpath) == 0 &&
+            le16_to_cpu(udev->descriptor.idVendor) == quec_hub_expects[i].vid &&
+            le16_to_cpu(udev->descriptor.idProduct) == quec_hub_expects[i].pid) {
+            scan->found_mask |= (1u << i);
+        }
+    }
+    return 0;
+}
+
+static void quec_power_cycle_hub(struct quec_power_ctrl_data *ctrl,
+                                 struct gpio_desc *gpio, const char *name,
+                                 int off_val, int on_val)
+{
+    gpiod_set_value_cansleep(gpio, off_val);
+    usleep_range(HUB2_RESTART_MS * 1000, HUB2_RESTART_MS * 1000 + 100000);
+    gpiod_set_value_cansleep(gpio, on_val);
+}
+
+// run USB scan, return found_mask
+static unsigned int __scan_usb_hubs(void)
+{
+    struct quec_hub_scan scan;
+
+    scan.found_mask = 0;
+    usb_for_each_dev(&scan, quec_hub_match);
+    return scan.found_mask;
+}
+
+// step-by-step host check (avoid long blocking)
+static void quec_host_check_work(struct work_struct *work)
+{
+    struct quec_power_ctrl_data *ctrl =
+        container_of(to_delayed_work(work),
+                     struct quec_power_ctrl_data, check_work);
+    unsigned int found_mask;
+    int present_cnt;
+    int phase;
+    int i;
+
+    if (!atomic_read(&ctrl->in_host)) {
+        dev_err(ctrl->dev, "host check: skipped (not in host mode)\n");
+        return;
+    }
+
+    phase = atomic_read(&ctrl->check_phase);
+    dev_info(ctrl->dev, "host check: phase=%d run\n", phase);
+
+    switch (phase) {
+
+    case CHECK_PHASE_SCAN1:
+        // 1st scan: check all 4 hubs
+        found_mask = __scan_usb_hubs();
+        present_cnt = hweight32(found_mask);
+
+        for (i = 0; i < (int)QUEC_HUB_EXPECT_COUNT; i++) {
+            bool present = !!(found_mask & (1u << i));
+            dev_info(ctrl->dev, "host check: %s present=%d\n",
+                    quec_hub_expects[i].name, present);
+        }
+
+        if (present_cnt == QUEC_HUB_EXPECT_COUNT) {
+            dev_info(ctrl->dev, "host check: all 4 hubs ok, no action\n");
+            atomic_set(&ctrl->check_phase, CHECK_PHASE_DONE);
+            return;
+        }
+
+        // need to cycle hub2
+        if (ctrl->usbhub2_en) {
+            dev_info(ctrl->dev, "host check: %d/4 hubs, power-cycle hub2\n",
+                present_cnt);
+            quec_power_cycle_hub(ctrl, ctrl->usbhub2_en, "hub2", 0, 1);
+            // schedule 2nd scan after hub2 recovery
+            atomic_set(&ctrl->check_phase, CHECK_PHASE_SCAN2);
+            queue_delayed_work(ctrl->wq, &ctrl->check_work,
+                              msecs_to_jiffies(2500));
+        } else {
+            // no hub2 GPIO, try hub1
+            atomic_set(&ctrl->check_phase, CHECK_PHASE_HUB1_CYCLE);
+            queue_delayed_work(ctrl->wq, &ctrl->check_work,
+                              msecs_to_jiffies(0));
+        }
+        break;
+
+    case CHECK_PHASE_SCAN2:
+        // 2nd scan: verify hub2 recovery
+        found_mask = __scan_usb_hubs();
+        present_cnt = hweight32(found_mask);
+
+        for (i = 0; i < (int)QUEC_HUB_EXPECT_COUNT; i++) {
+            bool present = !!(found_mask & (1u << i));
+            dev_info(ctrl->dev, "host check: %s present=%d (after hub2 cycle)\n",
+                    quec_hub_expects[i].name, present);
+        }
+
+        if (present_cnt == QUEC_HUB_EXPECT_COUNT) {
+            dev_info(ctrl->dev, "host check: hub2 power-cycle recovered, "
+                                "all 4 hubs ok\n");
+            atomic_set(&ctrl->check_phase, CHECK_PHASE_DONE);
+            return;
+        }
+
+        // hub2 cycle failed, try hub1
+        atomic_set(&ctrl->check_phase, CHECK_PHASE_HUB1_CYCLE);
+        queue_delayed_work(ctrl->wq, &ctrl->check_work,
+                          msecs_to_jiffies(0));
+        break;
+
+    case CHECK_PHASE_HUB1_CYCLE:
+        // hub1 power cycle (last resort)
+        if (ctrl->usbhub1_en) {
+            dev_info(ctrl->dev, "host check: power-cycle hub1\n");
+            quec_power_cycle_hub(ctrl, ctrl->usbhub1_en, "hub1", 1, 0);
+        }
+        atomic_set(&ctrl->check_phase, CHECK_PHASE_DONE);
+        break;
+
+    default:
+        dev_warn(ctrl->dev, "host check: unknown phase %d\n", phase);
+        atomic_set(&ctrl->check_phase, CHECK_PHASE_DONE);
+        break;
+    }
+}
+
+static ssize_t mode_sw_store(struct device *dev,
+                            struct device_attribute *attr,
+                            const char *buf, size_t count)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+    int val;
+
+    if (!data->mode_sw)
+        return -ENODEV;
+
+    if (kstrtoint(buf, 0, &val))
+        return -EINVAL;
+
+    /* run switch sequence only on real GPIO change */
+    if (gpiod_get_value_cansleep(data->mode_sw) != (val ? 1 : 0)) {
+        mutex_lock(&data->mode_lock);
+
+        if (data->usbhub1_en)
+            gpiod_set_value_cansleep(data->usbhub1_en, 1);  // hub1 off
+        if (data->eth_en)
+            gpiod_set_value_cansleep(data->eth_en, 0);
+
+        // wait for discharge settle
+        usleep_range(40000, 60000);
+
+        // switch USB mode
+        gpiod_set_value_cansleep(data->mode_sw, val ? 1 : 0);
+
+        // wait for mode switch
+        usleep_range(30000, 50000);
+
+        if (data->usbhub1_en) {
+            gpiod_set_value_cansleep(data->usbhub1_en, 0);
+            usleep_range(150000, 200000);
+        }
+        if (data->eth_en) {
+            gpiod_set_value_cansleep(data->eth_en, 1);
+        }
+
+        mutex_unlock(&data->mode_lock);
+    }
+
+    /* hub check triggers only here (sw path); extcon only drives port_pw_en */
+    if (val == 0) {
+        atomic_set(&data->in_host, 1);
+        atomic_set(&data->check_phase, CHECK_PHASE_SCAN1);
+        dev_info(data->dev, "mode_sw: switch to HOST, schedule check_work "
+                            "in %dms\n", CHECK_DELAY_MS);
+        queue_delayed_work(data->wq, &data->check_work,
+                          msecs_to_jiffies(CHECK_DELAY_MS));
+    } else {
+        cancel_delayed_work_sync(&data->check_work);
+        atomic_set(&data->in_host, 0);
+        atomic_set(&data->check_phase, CHECK_PHASE_DONE);
+        dev_info(data->dev, "mode_sw: switch to DEVICE\n");
+    }
+
+    /* no extcon fallback: drive port_pw_en directly */
+    if (!data->extcon && data->port_pw_en)
+        gpiod_set_value_cansleep(data->port_pw_en, val == 0 ? 1 : 0);
+
+    return count;
+}
+static DEVICE_ATTR_RW(mode_sw);
+
+static ssize_t eth_en_show(struct device *dev,
+                           struct device_attribute *attr, char *buf)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+
+    if (!data->eth_en)
+        return sprintf(buf, "no-gpio\n");
+    return sprintf(buf, "%d\n", gpiod_get_value_cansleep(data->eth_en));
+}
+
+static ssize_t eth_en_store(struct device *dev,
+                            struct device_attribute *attr,
+                            const char *buf, size_t count)
+{
+    struct quec_power_ctrl_data *data = dev_get_drvdata(dev);
+    int val;
+
+    if (!data->eth_en)
+        return -ENODEV;
+
+    if (kstrtoint(buf, 0, &val))
+        return -EINVAL;
+
+    gpiod_set_value_cansleep(data->eth_en, val ? 1 : 0);
+    return count;
+}
+static DEVICE_ATTR_RW(eth_en);
+
+static struct attribute *quec_power_attrs[] = {
+    &dev_attr_usbhub1_en.attr,
+    &dev_attr_usbhub2_en.attr,
+    &dev_attr_port_pw_en.attr,
+    &dev_attr_mode_sw.attr,
+    &dev_attr_eth_en.attr,
+    NULL,
+};
+
+static const struct attribute_group quec_power_group = {
+    .attrs = quec_power_attrs,
+};
+
+static int quec_power_ctrl_probe(struct platform_device *pdev)
+{
+    struct quec_power_ctrl_data *data;
+    int ret;
+
+    data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+    if (!data)
+        return -ENOMEM;
+
+    data->dev = &pdev->dev;
+
+    data->usbhub1_en = devm_gpiod_get_optional(&pdev->dev, "usbhub1-en", GPIOD_OUT_HIGH);
+    data->usbhub2_en = devm_gpiod_get_optional(&pdev->dev, "usbhub2-en", GPIOD_OUT_LOW);
+    data->port_pw_en = devm_gpiod_get_optional(&pdev->dev, "port-pw-en", GPIOD_OUT_LOW);
+    data->mode_sw    = devm_gpiod_get_optional(&pdev->dev, "mode-sw", GPIOD_OUT_LOW);
+    data->eth_en     = devm_gpiod_get_optional(&pdev->dev, "eth-en", GPIOD_OUT_LOW);
+
+    platform_set_drvdata(pdev, data);
+
+    data->extcon = NULL;
+    if (of_property_read_bool(pdev->dev.of_node, "extcon")) {
+        data->extcon = extcon_get_edev_by_phandle(&pdev->dev, 0);
+        if (IS_ERR(data->extcon)) {
+            ret = PTR_ERR(data->extcon);
+            data->extcon = NULL;
+            if (ret == -ENODEV) {
+                dev_info(&pdev->dev,
+                         "quec_power_ctrl: extcon phandle resolve failed, "
+                         "skip hw-switch monitoring\n");
+            } else {
+                // real error (-EPROBE_DEFER etc): return
+                dev_info(&pdev->dev,
+                         "quec_power_ctrl: get extcon failed ret=%d\n", ret);
+                return ret;
+            }
+        }
+    } else {
+        dev_info(&pdev->dev,
+                 "quec_power_ctrl: no extcon property, "
+                 "skip hw-switch monitoring\n");
+    }
+
+    // init mutex for mode switch (before sysfs expose to avoid race)
+    mutex_init(&data->mode_lock);
+
+    // init work + atomic state before sysfs expose
+    atomic_set(&data->in_host, 0);
+    atomic_set(&data->check_phase, CHECK_PHASE_DONE);  // default: done
+    INIT_DELAYED_WORK(&data->check_work, quec_host_check_work);
+
+    // create dedicated ordered workqueue
+    data->wq = alloc_ordered_workqueue("quec_power_ctrl",
+                                       WQ_MEM_RECLAIM | WQ_FREEZABLE);
+    if (!data->wq) {
+        dev_err(&pdev->dev, "quec_power_ctrl: failed to alloc workqueue\n");
+        return -ENOMEM;
+    }
+
+    // sysfs last: only expose after mutex/work/wq all ready
+    ret = sysfs_create_group(&pdev->dev.kobj, &quec_power_group);
+    if (ret) {
+        dev_err(&pdev->dev, "quec_power_ctrl failed to create sysfs, ret: %d\n", ret);
+        destroy_workqueue(data->wq);
+        data->wq = NULL;
+        return ret;
+    }
+
+    if (data->usbhub1_en) {
+        /* GPIOD_OUT_HIGH already set it to 1(off), just turn on */
+        usleep_range(15000, 25000);                       // wait for GPIO stable
+        gpiod_set_value_cansleep(data->usbhub1_en, 0);   // on (active low)
+    }
+
+    if (data->usbhub2_en) {
+        /* Wait for hub1 stable before powering hub2 */
+        usleep_range(80000, 100000);                      // hub1 init time
+        gpiod_set_value_cansleep(data->usbhub2_en, 1);
+    }
+
+    if (data->eth_en) {
+        /* ETH PHY power-up settle time */
+        usleep_range(40000, 60000);                       // PHY init time
+        gpiod_set_value_cansleep(data->eth_en, 1);
+    }
+
+    if (data->mode_sw) {
+        gpiod_set_value_cansleep(data->mode_sw, 0);
+    }
+
+    /* sync initial port_pw_en from extcon state (notifier fires on change only) */
+    if (data->extcon) {
+        int host;
+
+        data->port_pw_nb.notifier_call = quec_port_pw_extcon_notifier;
+        ret = extcon_register_notifier(data->extcon, EXTCON_USB_HOST,
+                                       &data->port_pw_nb);
+        if (ret) {
+            dev_err(&pdev->dev,
+                    "quec_power_ctrl: register extcon notifier failed %d\n",
+                    ret);
+            data->extcon = NULL;   /* avoid unregister on unregistered nb */
+        } else {
+            host = extcon_get_state(data->extcon, EXTCON_USB_HOST);
+            dev_info(&pdev->dev,
+                     "quec_power_ctrl: extcon initial state=%d (%s)\n",
+                     host, host > 0 ? "host" : "device");
+            if (data->port_pw_en)
+                gpiod_set_value_cansleep(data->port_pw_en, host > 0 ? 1 : 0);
+        }
+    }
+
+    /* no extcon (or register failed): default port_pw_en to host */
+    if (!data->extcon && data->port_pw_en)
+        gpiod_set_value_cansleep(data->port_pw_en, 1);
+
+    dev_info(&pdev->dev, "quec_power_ctrl driver loaded\n");
+    return 0;
+}
+
+static int quec_power_ctrl_remove(struct platform_device *pdev)
+{
+    struct quec_power_ctrl_data *data = platform_get_drvdata(pdev);
+
+    if (data->extcon)
+        extcon_unregister_notifier(data->extcon, EXTCON_USB_HOST,
+                                   &data->port_pw_nb);
+
+    /* remove sysfs first so no store callback can reach wq afterwards */
+    sysfs_remove_group(&pdev->dev.kobj, &quec_power_group);
+
+    cancel_delayed_work_sync(&data->check_work);
+
+    if (data->wq)
+        destroy_workqueue(data->wq);
+
+    return 0;
+}
+
+static void quec_power_ctrl_shutdown(struct platform_device *pdev)
+{
+    struct quec_power_ctrl_data *data = platform_get_drvdata(pdev);
+
+    if (!data)
+        return;
+
+    if (data->extcon)
+        extcon_unregister_notifier(data->extcon, EXTCON_USB_HOST,
+                                   &data->port_pw_nb);
+
+    cancel_delayed_work_sync(&data->check_work);
+    atomic_set(&data->in_host, 0);
+    atomic_set(&data->check_phase, CHECK_PHASE_DONE);
+
+    if (data->eth_en)
+        gpiod_set_value_cansleep(data->eth_en, 0);      // eth off
+
+    if (data->port_pw_en)
+        gpiod_set_value_cansleep(data->port_pw_en, 0);  // port off
+
+    if (data->usbhub2_en)
+        gpiod_set_value_cansleep(data->usbhub2_en, 0);  // hub2 off
+
+    if (data->usbhub1_en)
+        gpiod_set_value_cansleep(data->usbhub1_en, 1);  // hub1 off (active low)
+
+    dev_info(&pdev->dev, "quec_power_ctrl powered off on shutdown\n");
+}
+
+static const struct of_device_id quec_power_ctrl_of_match[] = {
+    { .compatible = "quectel,gpio-ctrl" },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, quec_power_ctrl_of_match);
+
+static struct platform_driver quec_power_ctrl_driver = {
+    .probe  = quec_power_ctrl_probe,
+    .remove = quec_power_ctrl_remove,
+    .shutdown = quec_power_ctrl_shutdown,
+    .driver = {
+        .name           = "quec_power_ctrl",
+        .of_match_table = quec_power_ctrl_of_match,
+    },
+};
+module_platform_driver(quec_power_ctrl_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_AUTHOR("Igni Li");
+MODULE_DESCRIPTION("Multi-GPIO control driver with independent sysfs callbacks");
