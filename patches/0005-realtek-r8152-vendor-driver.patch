+static int r8156b_u2phy_backup(struct r8152 *tp)
+{
+	static u8 u2phy_backup[] = {
+		0x00, 0x00, 0x1b, 0x18,
+		0x99, 0xcd, 0x6c, 0x61,
+		0x01, 0x81, 0xfc, 0x08,
+		0x00, 0x11, 0x9b, 0x15,
+		0x00, 0x0a, 0x00, 0x00 };
+
+	return generic_ocp_write(tp, 0xd3cc, 0x3c, sizeof(u2phy_backup),
+				 u2phy_backup, MCU_TYPE_USB);
+}
