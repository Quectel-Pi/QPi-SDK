+	/* phy state */
+	if (ocp_write_byte(tp, MCU_TYPE_PLA, 0xb014, 0x4c) < 0)
+		return false;
+	if (ocp_read_word(tp, MCU_TYPE_PLA, 0xb01a, &nway_state) < 0)
+		return false;
+
+	/* bit 15: TXDIS_STATE, bit 14: ABD_STATE */
+	if (nway_state & 0xc000)
+		return false;
+	else
+		return true;
