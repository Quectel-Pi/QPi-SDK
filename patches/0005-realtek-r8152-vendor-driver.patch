+static void rtl8152_get_strings(struct net_device *dev, u32 stringset, u8 *data)
+{
+	switch (stringset) {
+	case ETH_SS_STATS:
+		memcpy(data, rtl8152_gstrings, sizeof(rtl8152_gstrings));
+		break;
+	}
+}
