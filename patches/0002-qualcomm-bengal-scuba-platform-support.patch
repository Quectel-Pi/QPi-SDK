+
+	/* get variant */
+	string_address = stringAddress;
+	variantLen = cus_get_image_variant_version(string_address, tempImageVersion, IMAGE_MAX_LEN, &varianEndPos);
+	if (variantLen < 0 || varianEndPos >= IMAGE_MAX_LEN) {
+		//pr_err("%s : get image crm version failed: variantLen = %lu varianEndPos= %lu\n", __func__, variantLen, varianEndPos);
+		return -1;
+	}
+
+	/* Find the starting position of imageVersion */
+	string_address = stringAddress;
+	string_address += varianEndPos;
+	do {
+		string_address += 1;
+		varianEndPos++;
+	} while( (*string_address == '\0' ) && (varianEndPos < IMAGE_MAX_LEN));
+
+	if (varianEndPos >= IMAGE_MAX_LEN) {
+		//pr_err("%s : not get variant is too big : varianEndPos = %lu \n", __func__, varianEndPos);
+		return -1;
+	}
+
+	/* Remove the colon, whether to remove the colon or not, choose according to actual needs */
+#if 1
+	if (*string_address == ':') {
+		string_address +=1;
+	}
+#endif
+
+	imageVersionLen = strlen(string_address);
+	strncpy(imageVersion, string_address, imageVersionLen);
+
+	return imageVersionLen;
+}
