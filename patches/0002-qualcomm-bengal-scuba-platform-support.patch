+int cus_get_image_crm_version(char* stringAddress, char* imageCrmVersion, size_t crmVersionbufLen)
+{
+	char *string_address = NULL;
+	size_t crmLen = 0;
+
+	if (stringAddress == NULL || imageCrmVersion == NULL || crmVersionbufLen < IMAGE_MAX_LEN) {
+		//pr_err("%s : get error params\n", __func__);
+		return -1;
+	}
+
+	string_address = stringAddress;
+	crmLen = strlen(string_address);
+	if (crmLen >= crmVersionbufLen) {
+		//pr_err("%s : the string_address is too big : crmLen = %lu ;crmVersionbufLen = %lu\n", __func__, crmLen, crmVersionbufLen);
+		return -1;
+	}
+
+	strncpy(imageCrmVersion, string_address, crmLen);
+	return crmLen;
+}
+
+int cus_get_image_variant_version(char* stringAddress, char* variant, size_t variantVersionbufLen, size_t *endPos)
+ {
+	char *string_address = NULL;
+	size_t crmLen = 0;
+	size_t variantLen = 0;
+	char imageCrmVersion[IMAGE_MAX_LEN] ={0};
+	if (stringAddress == NULL || variant == NULL || variantVersionbufLen < IMAGE_MAX_LEN) {
+		//pr_err("%s : get error params\n", __func__);
+		return -1;
+	}
+
+	/* get crm */
+	crmLen = cus_get_image_crm_version(stringAddress, imageCrmVersion, IMAGE_MAX_LEN);
+	if (crmLen < 0) {
+		//pr_err("%s : get image crm version failed: crmLen = %lu\n", __func__, crmLen);
+		return -1;
+	}
+
+	/* Find the starting position of the variant */
+	string_address = stringAddress;
+	string_address += crmLen;
+	do {
+		string_address += 1;
+		crmLen++;
+	} while( (*string_address == '\0' ) && (crmLen < IMAGE_MAX_LEN));
+
+	if (crmLen >= IMAGE_MAX_LEN) {
+		//pr_err("%s : not get variant is too big : crmLen = %lu \n", __func__, crmLen);
+		return -1;
+	}
+
+	variantLen = strlen(string_address);
+	strncpy(variant, string_address, variantLen);
+
+	*endPos = crmLen + variantLen;
+	return variantLen;
+}
+
+int cus_get_image_version(char* stringAddress, char* imageVersion, size_t imageVersionbufLen)
