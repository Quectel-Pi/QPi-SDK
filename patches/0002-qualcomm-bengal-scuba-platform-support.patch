@@ -2941,10 +2942,17 @@ static int arm_smmu_def_domain_type(struct device *dev)
 {
 	struct arm_smmu_master_cfg *cfg = dev_iommu_priv_get(dev);
 	const struct arm_smmu_impl *impl;
+	struct device_node *np;
+	const char *str;
 
 	if (!cfg)
 		return 0;
 
+	np = arm_smmu_get_of_node(dev);
+	if (np && !of_property_read_string(np, "qcom,iommu-dma", &str) &&
+	    !strcmp(str, "lazy"))
+		return IOMMU_DOMAIN_DMA_FQ;
+
 	impl = cfg->smmu->impl;
 	if (impl && impl->def_domain_type)
 		return impl->def_domain_type(dev);
@@ -3070,6 +3078,8 @@ static int arm_smmu_enable_s1_translation(struct iommu_domain *domain)
 	struct arm_smmu_domain *smmu_domain = to_smmu_domain(domain);
 	struct arm_smmu_cfg *cfg = &smmu_domain->cfg;
 	struct arm_smmu_device *smmu = smmu_domain->smmu;
+	struct io_pgtable_ops *pgtbl_ops = smmu_domain->pgtbl_ops;
+	struct io_pgtable *iop = io_pgtable_ops_to_pgtable(pgtbl_ops);
 	int idx;
 	struct arm_smmu_cb *cb;
 	int ret;
@@ -3090,11 +3100,47 @@ static int arm_smmu_enable_s1_translation(struct iommu_domain *domain)
 	idx = cfg->cbndx;
 	cfg->sctlr.m = 1;
 	cb = &smmu->cbs[idx];
+
+	/*
+	 * Update TTBR from io_pgtable. When using qcom,iommu-earlymap,
+	 * the initial domain initialization happens before any mappings,
+	 * so cb->ttbr was 0 at that time. The actual root page table is
+	 * allocated later when mapping the splash region, and the TTBR
+	 * is stored in io_pgtable->cfg. We need to sync it to cb->ttbr
+	 * before writing the context bank.
+	 */
+	if (cfg->fmt != ARM_SMMU_CTX_FMT_AARCH32_S) {
+		cb->ttbr[0] = FIELD_PREP(ARM_SMMU_TTBRn_ASID, cfg->asid);
+		cb->ttbr[1] = FIELD_PREP(ARM_SMMU_TTBRn_ASID, cfg->asid);
+
+		if (iop->cfg.quirks & IO_PGTABLE_QUIRK_ARM_TTBR1)
+			cb->ttbr[1] |= iop->cfg.arm_lpae_s1_cfg.ttbr;
+		else
+			cb->ttbr[0] |= iop->cfg.arm_lpae_s1_cfg.ttbr;
+
+		cb->mair[0] = iop->cfg.arm_lpae_s1_cfg.mair;
+		cb->mair[1] = iop->cfg.arm_lpae_s1_cfg.mair >> 32;
+	} else {
+		cb->ttbr[0] = iop->cfg.arm_v7s_cfg.ttbr;
+		cb->ttbr[1] = 0;
+		cb->mair[0] = iop->cfg.arm_v7s_cfg.prrr;
+		cb->mair[1] = iop->cfg.arm_v7s_cfg.nmrr;
+	}
+
 	cb->sctlr = arm_smmu_lpae_sctlr(cfg);
 
-	arm_smmu_cb_write(smmu, idx, ARM_SMMU_CB_SCTLR, cb->sctlr);
-	arm_smmu_rpm_put(smmu);
+	/*
+	 * Rewrite the full context bank including TTBR and MAIR,
+	 * not just SCTLR. During delayed S1 enable, page tables may
+	 * have been allocated/mapped after the initial domain
+	 * initialization. After 500ms delay for active splash handoff,
+	 * the SMMU may have runtime suspended and lost all register
+	 * values. Writing only SCTLR leaves TTBR at 0, causing
+	 * continuous translation faults on the first DMA access.
+	 */
+	arm_smmu_write_context_bank(smmu, idx);
 	smmu_domain->delayed_s1_trans_enable = false;
+	arm_smmu_rpm_put(smmu);
 out:
 	mutex_unlock(&smmu_domain->init_mutex);
 	return ret;
