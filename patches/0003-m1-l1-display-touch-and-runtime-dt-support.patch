diff --git a/drivers/gpu/drm/bridge/waveshare-bl.c b/drivers/gpu/drm/bridge/waveshare-bl.c
new file mode 100644
index 0000000000000000000000000000000000000000..c8d6ee62d82fcd4ea778f0e3c43aafc5726f020b
--- /dev/null
+++ b/drivers/gpu/drm/bridge/waveshare-bl.c
@@ -0,0 +1,722 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright © 2023 Raspberry Pi Ltd
+ *
+ * Based on panel-raspberrypi-touchscreen by Broadcom
+ */
+
+#include <linux/backlight.h>
+#include <linux/i2c.h>
+#include <linux/err.h>
+#include <linux/module.h>
+#include <linux/regulator/consumer.h>
+#include <linux/gpio/consumer.h>
+#include <linux/err.h>
+#include <linux/debugfs.h>
+#include <linux/sysfs.h>
+#include <linux/delay.h>
+#include <linux/pm_runtime.h>
+
+struct ws_panel {
+    struct i2c_client *i2c;
+    struct backlight_device *bl_dev;
+    struct regulator *vddio_i2c;
+    struct regulator *vdd_ana;
+    struct gpio_desc *switch_gpio;
+    struct gpio_desc *power_gpio;
+    struct dentry *debugfs_dir;
+    struct device *dev;
+};
+
+// 模块参数用于调试
+static bool debug_mode = false;
+module_param(debug_mode, bool, 0644);
+MODULE_PARM_DESC(debug_mode, "Enable debug mode");
+
+#define WAVESHARE_BL_VDD_USE    0
+
+// 全局面板实例指针（用于与显示驱动通信）
+static struct ws_panel *g_ws_panel = NULL;
+
+// 获取面板实例的函数
+struct ws_panel *ws_panel_get_instance(void)
+{
+    return g_ws_panel;
+}
+EXPORT_SYMBOL_GPL(ws_panel_get_instance);
+
+// 写读寄存器函数
+int ws_panel_i2c_read(u8 reg)
+{
+    int ret = 0;
+    struct ws_panel *ts = ws_panel_get_instance();
+    
+    if (!ts || !ts->i2c) {
+        pr_err("[%s:%d]: invalid parameter!\n", __func__, __LINE__);
+        return -EINVAL;
+    }
+    
+    ret = i2c_smbus_read_byte_data(ts->i2c, reg);
+    if (ret < 0) {
+        pr_err("[%s:%d]: I2C read failed at reg 0x%02x: %d\n", __func__, __LINE__, reg, ret);
+        return ret;
+    }
+    
+    return ret;
+}
+EXPORT_SYMBOL_GPL(ws_panel_i2c_read);
+
+// 写寄存器函数
+int ws_panel_i2c_write(u8 reg, u8 val)
+{
+    int ret;
+    struct ws_panel *ts = ws_panel_get_instance();
+    
+    if (!ts || !ts->i2c) {
+        pr_err("[%s:%d]: invalid parameter!\n", __func__, __LINE__);
+        return -EINVAL;
+    }
+    
+    ret = i2c_smbus_write_byte_data(ts->i2c, reg, val);
+    if (ret) {
+        pr_err("[%s:%d]: I2C write failed at reg 0x%02x: %d\n", __func__, __LINE__, reg, ret);
+        return ret;
+    }
+    
+    return ret;
+}
+EXPORT_SYMBOL_GPL(ws_panel_i2c_write);
+
+int ws_panel_set_backlight(unsigned int value)
+{
+    int ret = 0;
+    struct ws_panel *ts = ws_panel_get_instance();
+
+    if (!ts) {
+        pr_err("[%s:%d]: invalid parameter!\n", __func__, __LINE__);
+        return -EINVAL;
+    }
+    
+    ret = ws_panel_i2c_write(0xab, 0xff - value);
+    if (ret != 0) {
+        pr_err("[%s:%d]: I2C write failed at reg 0xab: %d\n", __func__, __LINE__, ret);
+        return ret;
+    }
+    
+    ret = ws_panel_i2c_write(0xaa, 0x01);
+    if (ret != 0) {
+        pr_err("[%s:%d]: I2C write failed at reg 0xaa: %d\n", __func__, __LINE__, ret);
+        return ret;
+    }
+    
+    return ret;
+}
+EXPORT_SYMBOL_GPL(ws_panel_set_backlight);
+
+// 更新背光状态的回调函数
+static int ws_panel_bl_update_status(struct backlight_device *bl)
+{
+    int brightness = backlight_get_brightness(bl);
+    
+    return ws_panel_set_backlight(brightness);
+}
+
+static const struct backlight_ops ws_panel_bl_ops = {
+    .update_status = ws_panel_bl_update_status,
+};
+
+// 在探测函数中调用此函数来注册背光设备
+static struct backlight_device *ws_panel_create_backlight(struct ws_panel *ts)
+{
+    struct device *dev = &ts->i2c->dev;
+    const struct backlight_properties props = {
+        .type = BACKLIGHT_RAW,
+        .brightness = 255, // 默认亮度
+        .max_brightness = 255, // 最大亮度
+    };
+    
+    // 使用devm_backlight_device_register注册背光设备
+    return devm_backlight_device_register(dev, dev_name(dev), dev, ts,
+                                          &ws_panel_bl_ops, &props);
+}
+
+void ws_panel_switch_mipi(bool switch_ws)
+{
+    struct ws_panel *ts = ws_panel_get_instance();
+    if (ts && ts->switch_gpio) {
+        if (switch_ws) {
+            pr_info("%s: switch to L\n", __func__);
+            gpiod_set_value_cansleep(ts->switch_gpio, 0);
+        } else {
+            pr_info("%s: switch to H\n", __func__);
+            gpiod_set_value_cansleep(ts->switch_gpio, 1);
+        }
+    }
+}
+EXPORT_SYMBOL_GPL(ws_panel_switch_mipi);
+
+void ws_panel_poweron_mipi(void)
+{
+    struct ws_panel *ts = ws_panel_get_instance();
+    if (ts && ts->power_gpio) {
+        // gpiod_set_value_cansleep(ts->power_gpio, 0);
+        // mdelay(100);
+        gpiod_set_value_cansleep(ts->power_gpio, 1);
+    }
+}
+EXPORT_SYMBOL_GPL(ws_panel_poweron_mipi);
+
+// 调试接口实现
+static ssize_t reg_read_store(struct device *dev,
+                             struct device_attribute *attr,
+                             const char *buf, size_t count)
+{
+    unsigned int reg;
+    int ret;
+    
+    if (sscanf(buf, "%x", &reg) != 1)
+        return -EINVAL;
+    
+    ret = ws_panel_i2c_read(reg);
+    if (ret < 0) {
+        dev_err(dev, "Failed to read reg 0x%02x: %d\n", reg, ret);
+        return ret;
+    }
+    
+    dev_info(dev, "Read reg 0x%02x: 0x%02x\n", reg, ret);
+    return count;
+}
+
+static ssize_t reg_write_store(struct device *dev,
+                              struct device_attribute *attr,
+                              const char *buf, size_t count)
+{
+    unsigned int reg, val;
+    int ret;
+    
+    if (sscanf(buf, "%x %x", &reg, &val) != 2)
+        return -EINVAL;
+    
+    ret = ws_panel_i2c_write(reg, val);
+    if (ret) {
+        dev_err(dev, "Failed to write reg 0x%02x: %d\n", reg, ret);
+        return ret;
+    }
+    
+    dev_info(dev, "Write reg 0x%02x: 0x%02x\n", reg, val);
+    return count;
+}
+
+static ssize_t backlight_brightness_store(struct device *dev,
+                                         struct device_attribute *attr,
+                                         const char *buf, size_t count)
+{
+    unsigned int brightness;
+    int ret;
+    
+    if (sscanf(buf, "%u", &brightness) != 1)
+        return -EINVAL;
+    
+    if (brightness > 255)
+        brightness = 255;
+    
+    ret = ws_panel_set_backlight(brightness);
+    if (ret) {
+        dev_err(dev, "Failed to set backlight: %d\n", ret);
+        return ret;
+    }
+    
+    dev_info(dev, "Set backlight to %u\n", brightness);
+    return count;
+}
+
+static ssize_t power_status_show(struct device *dev,
+                                struct device_attribute *attr, char *buf)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    int vdd_ana_enabled = 0, vddio_enabled = 0;
+    
+    if (ts->vdd_ana)
+        vdd_ana_enabled = regulator_is_enabled(ts->vdd_ana);
+    
+    if (ts->vddio_i2c)
+        vddio_enabled = regulator_is_enabled(ts->vddio_i2c);
+    
+    return sprintf(buf, "vdd_ana: %s\nvddio_i2c: %s\n",
+                   vdd_ana_enabled ? "enabled" : "disabled",
+                   vddio_enabled ? "enabled" : "disabled");
+}
+
+static ssize_t gpio_status_show(struct device *dev,
+                               struct device_attribute *attr, char *buf)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    int switch_val = -1, power_val = -1;
+    
+    if (ts->switch_gpio)
+        switch_val = gpiod_get_value(ts->switch_gpio);
+    
+    if (ts->power_gpio)
+        power_val = gpiod_get_value(ts->power_gpio);
+    
+    return sprintf(buf, "switch_gpio: %d\npower_gpio: %d\n",
+                   switch_val, power_val);
+}
+
+// 新增：Power GPIO控制接口
+static ssize_t power_gpio_store(struct device *dev,
+                               struct device_attribute *attr,
+                               const char *buf, size_t count)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    unsigned int value;
+    
+    if (sscanf(buf, "%u", &value) != 1)
+        return -EINVAL;
+    
+    if (value > 1)
+        value = 1;
+    
+    if (ts && ts->power_gpio) {
+        gpiod_set_value_cansleep(ts->power_gpio, value);
+        dev_info(dev, "Set power GPIO to %u\n", value);
+    }
+    
+    return count;
+}
+
+static ssize_t power_gpio_show(struct device *dev,
+                              struct device_attribute *attr, char *buf)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    int value = -1;
+    
+    if (ts && ts->power_gpio)
+        value = gpiod_get_value(ts->power_gpio);
+    
+    return sprintf(buf, "%d\n", value);
+}
+
+// 新增：Switch GPIO控制接口
+static ssize_t switch_gpio_store(struct device *dev,
+                                struct device_attribute *attr,
+                                const char *buf, size_t count)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    unsigned int value;
+    
+    if (sscanf(buf, "%u", &value) != 1)
+        return -EINVAL;
+    
+    if (value > 1)
+        value = 1;
+    
+    if (ts && ts->switch_gpio) {
+        gpiod_set_value_cansleep(ts->switch_gpio, value);
+        dev_info(dev, "Set switch GPIO to %u\n", value);
+    }
+    
+    return count;
+}
+
+static ssize_t switch_gpio_show(struct device *dev,
+                               struct device_attribute *attr, char *buf)
+{
+    struct ws_panel *ts = dev_get_drvdata(dev);
+    int value = -1;
+    
+    if (ts && ts->switch_gpio)
+        value = gpiod_get_value(ts->switch_gpio);
+    
+    return sprintf(buf, "%d\n", value);
+}
+
+// 定义sysfs属性
+static DEVICE_ATTR_WO(reg_read);
+static DEVICE_ATTR_WO(reg_write);
+static DEVICE_ATTR_WO(backlight_brightness);
+static DEVICE_ATTR_RW(power_gpio);
+static DEVICE_ATTR_RW(switch_gpio);
+static DEVICE_ATTR_RO(power_status);
+static DEVICE_ATTR_RO(gpio_status);
+
+static struct attribute *ws_panel_attrs[] = {
+    &dev_attr_reg_read.attr,
+    &dev_attr_reg_write.attr,
+    &dev_attr_backlight_brightness.attr,
+    &dev_attr_power_gpio.attr,
+    &dev_attr_switch_gpio.attr,
+    &dev_attr_power_status.attr,
+    &dev_attr_gpio_status.attr,
+    NULL,
+};
+
+static const struct attribute_group ws_panel_group = {
+    .attrs = ws_panel_attrs,
+};
+
+// debugfs接口实现
+static ssize_t debug_registers_read(struct file *file, char __user *user_buf,
+                                   size_t count, loff_t *ppos)
+{
+//    struct ws_panel *ts = file->private_data;
+    char *buf;
+    int len = 0, ret;
+    int i;
+    
+    buf = kzalloc(1024, GFP_KERNEL);
+    if (!buf)
+        return -ENOMEM;
+    
+    len += snprintf(buf + len, 1024 - len, "Waveshare Panel Registers:\n");
+    
+    // 读取一些关键寄存器
+    for (i = 0; i <= 0x05; i++) {
+        ret = ws_panel_i2c_read(i);
+        if (ret >= 0) {
+            len += snprintf(buf + len, 1024 - len, "Reg 0x%02x: 0x%02x\n", i, ret);
+        } else {
+            len += snprintf(buf + len, 1024 - len, "Reg 0x%02x: ERROR(%d)\n", i, ret);
+        }
+    }
+    
+    ret = simple_read_from_buffer(user_buf, count, ppos, buf, len);
+    kfree(buf);
+    return ret;
+}
+
+// 新增：debugfs power控制接口
+static ssize_t debug_power_gpio_write(struct file *file,
+                                     const char __user *user_buf,
+                                     size_t count, loff_t *ppos)
+{
+    struct ws_panel *ts = file->private_data;
+    char buf[16];
+    unsigned int value;
+    
+    if (count >= sizeof(buf))
+        return -EINVAL;
+    
+    if (copy_from_user(buf, user_buf, count))
+        return -EFAULT;
+    
+    buf[count] = '\0';
+    
+    if (kstrtouint(buf, 10, &value))
+        return -EINVAL;
+    
+    if (value > 1)
+        value = 1;
+    
+    if (ts && ts->power_gpio) {
+        gpiod_set_value_cansleep(ts->power_gpio, value);
+        pr_info("Debug: Set power GPIO to %u\n", value);
+    }
+    
+    return count;
+}
+
+static ssize_t debug_power_gpio_read(struct file *file, char __user *user_buf,
+                                    size_t count, loff_t *ppos)
+{
+    struct ws_panel *ts = file->private_data;
+    char buf[16];
+    int len, value = -1;
+    
+    if (ts && ts->power_gpio)
+        value = gpiod_get_value(ts->power_gpio);
+    
+    len = snprintf(buf, sizeof(buf), "%d\n", value);
+    
+    return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+// 新增：debugfs switch控制接口
+static ssize_t debug_switch_gpio_write(struct file *file,
+                                      const char __user *user_buf,
+                                      size_t count, loff_t *ppos)
+{
+    struct ws_panel *ts = file->private_data;
+    char buf[16];
+    unsigned int value;
+    
+    if (count >= sizeof(buf))
+        return -EINVAL;
+    
+    if (copy_from_user(buf, user_buf, count))
+        return -EFAULT;
+    
+    buf[count] = '\0';
+    
+    if (kstrtouint(buf, 10, &value))
+        return -EINVAL;
+    
+    if (value > 1)
+        value = 1;
+    
+    if (ts && ts->switch_gpio) {
+        gpiod_set_value_cansleep(ts->switch_gpio, value);
+        pr_info("Debug: Set switch GPIO to %u\n", value);
+    }
+    
+    return count;
+}
+
+static ssize_t debug_switch_gpio_read(struct file *file, char __user *user_buf,
+                                     size_t count, loff_t *ppos)
+{
+    struct ws_panel *ts = file->private_data;
+    char buf[16];
+    int len, value = -1;
+    
+    if (ts && ts->switch_gpio)
+        value = gpiod_get_value(ts->switch_gpio);
+    
+    len = snprintf(buf, sizeof(buf), "%d\n", value);
+    
+    return simple_read_from_buffer(user_buf, count, ppos, buf, len);
+}
+
+static const struct file_operations debug_registers_fops = {
+    .read = debug_registers_read,
+    .open = simple_open,
+    .llseek = default_llseek,
+};
+
+static const struct file_operations debug_power_gpio_fops = {
+    .read = debug_power_gpio_read,
+    .write = debug_power_gpio_write,
+    .open = simple_open,
+    .llseek = default_llseek,
+};
+
+static const struct file_operations debug_switch_gpio_fops = {
+    .read = debug_switch_gpio_read,
+    .write = debug_switch_gpio_write,
+    .open = simple_open,
+    .llseek = default_llseek,
+};
+
+static int ws_panel_debugfs_init(struct ws_panel *ts)
+{
+    ts->debugfs_dir = debugfs_create_dir("ws_panel", NULL);
+    if (IS_ERR(ts->debugfs_dir)) {
+        dev_warn(ts->dev, "Failed to create debugfs directory\n");
+        ts->debugfs_dir = NULL;
+        return PTR_ERR(ts->debugfs_dir);
+    }
+    
+    debugfs_create_file("registers", 0444, ts->debugfs_dir, ts, &debug_registers_fops);
+    debugfs_create_file("power_gpio", 0644, ts->debugfs_dir, ts, &debug_power_gpio_fops);
+    debugfs_create_file("switch_gpio", 0644, ts->debugfs_dir, ts, &debug_switch_gpio_fops);
+    
+    return 0;
+}
+
+static void ws_panel_debugfs_exit(struct ws_panel *ts)
+{
+    if (ts->debugfs_dir)
+        debugfs_remove_recursive(ts->debugfs_dir);
+}
+
+// 修改probe函数以设置全局指针
+static int ws_panel_probe(struct i2c_client *i2c, const struct i2c_device_id *id)
+{
+    int ret;
+    struct device *dev = &i2c->dev;
+    struct ws_panel *ts = NULL;
+    
+    pr_info("[%s:%d]: waveshare_8.0inch-panel probe start\n", __func__, __LINE__);
+    
+    ts = devm_kzalloc(dev, sizeof(*ts), GFP_KERNEL);
+    if (!ts) {
+        pr_err("%s: Failed to allocate memory for ws_panel\n", __func__);
+        return -ENOMEM;
+    }
+    
+    ts->i2c = i2c;
+    ts->dev = dev;
+    i2c_set_clientdata(i2c, ts);
+    
+    // 获取GPIO
+    ts->switch_gpio = devm_gpiod_get_optional(dev, "switch", GPIOD_ASIS); // GPIOD_OUT_LOW);
+    if (IS_ERR(ts->switch_gpio)) {
+        pr_err("failed to acquire switch gpio\n");
+        return PTR_ERR(ts->switch_gpio);
+    }
+    
+    ts->power_gpio = devm_gpiod_get_optional(dev, "power", GPIOD_OUT_HIGH);
+    if (IS_ERR(ts->power_gpio)) {
+        pr_err("failed to acquire power gpio\n");
+        return PTR_ERR(ts->power_gpio);
+    }
+
+    #if WAVESHARE_BL_VDD_USE
+    // 获取并启用vdd_ana调节器
+    ts->vdd_ana = devm_regulator_get(dev, "vdd_ana");
+    if (IS_ERR(ts->vdd_ana)) {
+        pr_err("%s: Failed to get vdd_ana regulator\n", __func__);
+        return PTR_ERR(ts->vdd_ana);
+    }
+    ret = regulator_enable(ts->vdd_ana);
+    if (ret) {
+        pr_err("%s: Failed to enable vdd_ana regulator, ret=%d\n", __func__, ret);
+        return ret;
+    }
+    
+    // 获取并启用vddio_i2c调节器
+    ts->vddio_i2c = devm_regulator_get(dev, "vddio_i2c");
+    if (IS_ERR(ts->vddio_i2c)) {
+        pr_err("%s: Failed to get vddio_i2c regulator\n", __func__);
+        ret = PTR_ERR(ts->vddio_i2c);
+        goto probe_err;
+    }
+    
+    ret = regulator_enable(ts->vddio_i2c);
+    if (ret) {
+        pr_err("%s: Failed to enable vddio_i2c regulator, ret=%d\n", __func__, ret);
+        goto probe_err;
+    }
+    #endif
+
+    // 添加电源稳定延时
+    mdelay(100);
+    
+    // 设置全局指针
+    g_ws_panel = ts;
+    
+    // 注册背光设备
+    ts->bl_dev = ws_panel_create_backlight(ts);
+    if (IS_ERR(ts->bl_dev)) {
+        ret = PTR_ERR(ts->bl_dev);
+        goto probe_err;
+    }
+    
+    // 保存设备指针用于调试
+    dev_set_drvdata(dev, ts);
+
+    // 创建sysfs调试接口
+    ret = sysfs_create_group(&dev->kobj, &ws_panel_group);
+    if (ret) {
+        dev_warn(dev, "Failed to create sysfs group: %d\n", ret);
+        // 继续执行，不因调试接口失败而影响驱动加载
+    }
+    
+    // 创建debugfs调试接口
+    ws_panel_debugfs_init(ts);
+    
+    pr_info("[%s:%d]: waveshare_8.0inch-panel probe end\n", __func__, __LINE__);
+    
+    return 0;
+    
+probe_err:
+    // if(ts->vddio_i2c) regulator_disable(ts->vddio_i2c);
+    // if(ts->vdd_ana) regulator_disable(ts->vdd_ana);
+    g_ws_panel = NULL;
+    return ret;
+}
+
+// 修改remove函数以清除全局指针
+static int ws_panel_remove(struct i2c_client *i2c)
+{
+    struct ws_panel *ts = i2c_get_clientdata(i2c);
+    struct device *dev = &i2c->dev;
+    
+    // 清除全局指针
+    g_ws_panel = NULL;
+    
+    // 清理debugfs
+    ws_panel_debugfs_exit(ts);
+    
+    // 清理sysfs
+    sysfs_remove_group(&dev->kobj, &ws_panel_group);
+    
+    // 释放背光设备
+    if (ts->bl_dev)
+        backlight_device_unregister(ts->bl_dev);
+    
+    #if WAVESHARE_BL_VDD_USE
+    // 禁用调节器
+    if (ts->vddio_i2c)
+        regulator_disable(ts->vddio_i2c);
+    
+    if (ts->vdd_ana)
+        regulator_disable(ts->vdd_ana);
+    #endif
+
+    return 0;
+}
+
+#ifdef CONFIG_PM_SLEEP
+static int ws_panel_suspend(struct device *dev)
+{
+    #if WAVESHARE_BL_VDD_USE
+    struct i2c_client *i2c = to_i2c_client(dev);
+    struct ws_panel *ts = i2c_get_clientdata(i2c);
+    
+    if (ts->vddio_i2c)
+        regulator_disable(ts->vddio_i2c);
+    
+    if (ts->vdd_ana)
+        regulator_disable(ts->vdd_ana);
+    #endif
+
+    return 0;
+}
+
+static int ws_panel_resume(struct device *dev)
+{
+    #if WAVESHARE_BL_VDD_USE
+    struct i2c_client *i2c = to_i2c_client(dev);
+    struct ws_panel *ts = i2c_get_clientdata(i2c);
+    int ret;
+ 
+    ret = regulator_enable(ts->vdd_ana);
+    if (ret) {
+        dev_err(dev, "Failed to enable vdd_ana: %d\n", ret);
+        return ret;
+    }
+    
+    ret = regulator_enable(ts->vddio_i2c);
+    if (ret) {
+        dev_err(dev, "Failed to enable vddio_i2c: %d\n", ret);
+        regulator_disable(ts->vdd_ana);
+        return ret;
+    }
+
+    msleep(100);
+    #endif
+
+    return 0;
+}
+#endif
+
+static const struct dev_pm_ops ws_panel_pm_ops = {
+#ifdef CONFIG_PM_SLEEP
+    .suspend = ws_panel_suspend,
+    .resume = ws_panel_resume,
+#endif
+};
+
+static const struct of_device_id ws_panel_of_ids[] = {
+    {
+        .compatible = "waveshare,8.0inch-panel",
+    },
+    { /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, ws_panel_of_ids);
+
+static struct i2c_driver ws_panel_driver = {
+    .driver = {
+        .name = "ws_touchscreen",
+        .of_match_table = ws_panel_of_ids,
+        .pm = &ws_panel_pm_ops,
+    },
+    .probe = ws_panel_probe,
+    .remove = ws_panel_remove,
+};
+module_i2c_driver(ws_panel_driver);
+
+MODULE_AUTHOR("Dave Stevenson <dave.stevenson@raspberrypi.com>");
+MODULE_DESCRIPTION("Waveshare DSI panel driver");
+MODULE_LICENSE("GPL");
